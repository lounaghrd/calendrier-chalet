rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validDate(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validBooking(d) {
      return d.keys().hasOnly(['title', 'who', 'start', 'end', 'people', 'guests', 'note',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['who', 'start', 'end', 'people'])
        && d.who in ['parents', 'louna', 'victor']
        && validDate(d.start) && validDate(d.end) && d.end > d.start
        && d.people is int && d.people >= 1 && d.people <= 14
        && d.get('title', '') is string && d.get('title', '').size() <= 80
        && d.get('guests', '') is string && d.get('guests', '').size() <= 200
        && d.get('note', '') is string && d.get('note', '').size() <= 500;
    }

    match /bookings/{bookingId} {
      allow read, delete: if true;
      allow create, update: if validBooking(request.resource.data);
    }
  }
}
